---
import { useTranslations } from '../i18n/index.js';

const t = useTranslations(Astro.currentLocale);
---
<!-- Portfolio Preloader / Retro Skeleton Boot Screen -->
<div id="portfolio-loader" class="fixed inset-0 z-[9999] flex flex-col items-center justify-center select-none bg-slate-950 transition-opacity duration-400 ease-out" role="status" aria-live="polite" aria-label={t.loader_aria}>
  <div class="flex flex-col items-center max-w-xs w-full px-4 text-center">
    <!-- Animated Companion Sprite -->
    <div class="relative w-20 h-20 mb-4 flex items-center justify-center">
      <img id="loader-sprite" src="/img/character-sprites/idle.png" alt={t.loader_alt} class="w-16 h-16 pixelated animate-bounce drop-shadow-[0_4px_12px_rgba(2,132,199,0.7)]" />
    </div>
    
    <!-- System Title & Retro Subtitle -->
    <div class="font-pixel text-xs sm:text-sm text-cyan-400 tracking-wider mb-1 font-bold">
      JOSUE TORRES SIBAJA
    </div>
    <div data-i18n="loader_init" class="text-[10px] font-mono text-slate-400 tracking-widest uppercase mb-4">{t.loader_init}</div>

    <!-- Stepped Pixel Progress Container with Outer Protective Casing -->
    <div class="loader-progress-wrapper p-1 sm:p-1.5 pixel-corners-btn relative inline-flex items-center justify-center">
      <div class="loader-progress-chassis w-56 sm:w-64 h-3.5 pixel-corners-btn relative overflow-hidden">
        <div id="loader-progress-bar" class="h-full bg-gradient-to-r from-brand-600 via-cyan-400 to-emerald-400 transition-all duration-200 ease-out" style="width: 15%;"></div>
      </div>
    </div>

    <!-- Status Row: Loading Assets text + Percentage -->
    <div class="flex items-center justify-between w-56 sm:w-64 text-[10px] font-mono text-slate-400 mt-2 px-0.5">
      <span id="loader-status-text" data-i18n="loader_status">{t.loader_status}</span>
      <span id="loader-percent" class="text-cyan-400 font-bold font-mono">15%</span>
    </div>
  </div>
</div>

