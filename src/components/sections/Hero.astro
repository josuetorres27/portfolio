---
import { useTranslations } from '../../i18n/index.js';

const t = useTranslations(Astro.currentLocale);
// Shown in the headline until the typewriter starts.
const firstPhrase = t.hero_phrases[0].split('\n').join(' ');
---
<!-- ================= HERO SECTION ================= -->
<section id="hero" class="relative z-20 pt-6 sm:pt-8 md:pt-28 pb-16 md:pb-20">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- Hero Text & Content -->
      <div id="hero-text-col" class="lg:col-span-8">

        <!-- Availability Status Badge (Pixel Art Stepped Style) -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-2 pixel-corners-btn bg-slate-900 border border-emerald-500/40 text-xs font-mono font-semibold text-emerald-400 mb-6 max-w-full">
          <span class="w-2 h-2 rounded-none bg-emerald-400 animate-pulse shrink-0"></span>
          <span data-i18n="hero_badge" class="break-words">{t.hero_badge}</span>
        </div>

        <!-- Main Headline with Dynamic Typewriter Effect -->
        <h1 id="hero-headline" class="text-3xl sm:text-5xl lg:text-[55px] font-extrabold tracking-tight text-white leading-tight mb-4 sm:mb-6">
          <span data-i18n-html="hero_greeting"><Fragment set:html={t.hero_greeting} /></span><br>
          <span id="hero-typewriter-wrapper" class="block min-h-[3.75em]"><span id="hero-typewriter" class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 via-indigo-300 to-cyan-400">{firstPhrase}</span><span id="hero-typewriter-cursor" class="typewriter-cursor" aria-hidden="true"></span></span>
        </h1>

        <!-- Value Proposition / Bio Summary -->
        <p data-i18n-html="hero_bio" class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed mb-8"><Fragment set:html={t.hero_bio} /></p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
          <a href="#projects" class="w-full sm:w-auto pixel-btn pixel-btn-primary pixel-corners-btn px-6 py-3.5 text-sm font-semibold">
            <span data-i18n="hero_btn_projects">{t.hero_btn_projects}</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>

          <!-- Dual CV & Resume Dropdown in Hero -->
          <div class="relative w-full sm:w-auto sm:inline-block" id="hero-cv-container">
            <button id="hero-cv-btn" type="button" aria-expanded="false" class="w-full sm:w-auto pixel-btn pixel-btn-secondary pixel-corners-btn px-5 py-3.5 text-sm font-semibold relative z-20">
              <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <span data-i18n="hero_btn_cv">{t.hero_btn_cv}</span>
              <svg id="hero-cv-arrow" class="w-3.5 h-3.5 text-slate-400 transition-transform duration-300 transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
            </button>
            <div id="hero-cv-dropdown" class="dropdown-animated dropdown-closed absolute left-0 right-0 w-full mt-2 pixel-corners-card py-2 z-10">
              <a href="/docs/Josue_Torres_Sibaja_Resume.pdf" target="_blank" download="Josue_Torres_Sibaja_Resume.pdf" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors">
                <span class="w-6 h-6 pixel-corners-btn bg-brand-500/15 border border-brand-500/40 text-brand-400 font-mono text-[10px] font-bold flex items-center justify-center shrink-0">EN</span>
                <div>
                  <p class="font-semibold text-white">Resume</p>
                  <p class="text-[10px] text-slate-400 font-mono">English (PDF)</p>
                </div>
              </a>
              <a href="/docs/Josue_Torres_Sibaja_CV.pdf" target="_blank" download="Josue_Torres_Sibaja_CV.pdf" class="flex items-center gap-2.5 px-4 py-2.5 text-xs font-medium text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors border-t border-slate-800/60">
                <span class="w-6 h-6 pixel-corners-btn bg-brand-500/15 border border-brand-500/40 text-brand-400 font-mono text-[10px] font-bold flex items-center justify-center shrink-0">ES</span>
                <div>
                  <p class="font-semibold text-white">Curriculum Vitae</p>
                  <p class="text-[10px] text-slate-400 font-mono">Español (PDF)</p>
                </div>
              </a>
            </div>
          </div>

          <!-- Quick Links: GitHub & LinkedIn -->
          <div class="flex items-center justify-center sm:justify-start gap-2.5 sm:gap-2 w-full sm:w-auto mt-1 sm:mt-0">
            <a href="https://github.com/josuetorres27" target="_blank" rel="noopener noreferrer" aria-label={t.aria_github_profile} data-i18n-aria="aria_github_profile" class="pixel-btn pixel-btn-icon pixel-corners-btn p-3 text-slate-400 hover:text-white">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
            </a>

            <a href="https://www.linkedin.com/in/josue-torres-sibaja/" target="_blank" rel="noopener noreferrer" aria-label={t.aria_linkedin_profile} data-i18n-aria="aria_linkedin_profile" class="pixel-btn pixel-btn-icon pixel-corners-btn p-3 text-slate-400 hover:text-white">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            </a>

            <a href="mailto:dev.josue.torres@gmail.com" aria-label={t.aria_send_email} data-i18n-aria="aria_send_email" class="pixel-btn pixel-btn-icon pixel-corners-btn p-3 text-slate-400 hover:text-white">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Hero Profile Photo -->
      <div class="lg:col-span-4 flex justify-center lg:justify-end pt-10 sm:pt-14 lg:pt-0">
        <div class="relative group transition-transform duration-300 hover:-translate-y-1.5" id="hero-photo-wrapper">
          <!-- Glow background behind stepped frame -->
          <div id="hero-photo-glow" class="absolute -inset-2 bg-gradient-to-r from-brand-500 via-cyan-500 to-blue-500 rounded-lg blur-xl opacity-35 group-hover:opacity-65 transition duration-500 pointer-events-none"></div>

          <!-- Pixel Art Stepped Photo Frame (Outer Cyan Border) -->
          <div class="pixel-photo-frame p-1 pixel-corners-photo w-64 sm:w-72 lg:w-80">
            <!-- Dark Console Chassis (Matching Quest Button Tone & Texture) -->
            <div class="pixel-photo-chassis px-2.5 sm:px-3 pt-3 sm:pt-3.5 pb-7 sm:pb-8 pixel-corners-photo flex flex-col">
              <!-- Integrated Arcade Header: Player 1 Name -->
              <div class="flex items-center justify-center mb-2 select-none">
                <span class="font-pixel text-xs sm:text-[13px] font-bold text-white tracking-wider uppercase group-hover:text-emerald-300 transition-colors" data-i18n="hero_player_tag">{t.hero_player_tag}</span>
              </div>

              <!-- Photo Screen -->
              <div id="hero-photo-card" class="lightbox-trigger relative w-full aspect-[4/5] overflow-hidden pixel-corners-sm cursor-pointer" role="button" tabindex="0" aria-label={t.aria_view_profile_photo} data-i18n-aria="aria_view_profile_photo">
                <img id="hero-profile-img" src="/img/portfolio.jpeg" alt="Josue Torres Sibaja | Computer Science Graduating Senior" class="w-full h-full object-cover object-top transition-all duration-300">
                <span data-i18n="hero_photo_caption" class="sr-only">{t.hero_photo_caption}</span>

                <!-- Portal Overlay & Big Pixel Character inside photo -->
                <div id="hero-portal-overlay" class="absolute inset-0 bg-slate-950/75 backdrop-blur-sm opacity-0 hidden pointer-events-none transition-opacity duration-300 flex items-center justify-center z-20"></div>
                <div id="hero-portal-sprite-wrap" class="absolute inset-0 flex items-center justify-center pointer-events-none z-30 opacity-0 hidden transition-opacity duration-200">
                  <img id="hero-portal-sprite" src="/img/character-sprites/front.png" class="w-32 h-32 sm:w-40 sm:h-40 pixelated drop-shadow-[0_10px_25px_rgba(6,182,212,0.85)] transform transition-transform duration-300 ease-out" alt={t.adv_companion_name} />
                </div>
              </div>
            </div>
          </div>

          <!-- Adventure Mode Trigger: Interactive Quest Module (Docked to bottom edge of frame) -->
          <div class="absolute -bottom-5 left-1/2 -translate-x-1/2 z-40 flex justify-center">
            <button id="start-adventure-btn" type="button" aria-label={t.adv_start_aria} class="pixel-quest-btn pixel-corners-btn inline-flex items-center gap-2.5 px-5 py-2.5 sm:px-7 sm:py-3.5 text-xs sm:text-sm font-mono font-bold text-white cursor-pointer select-none whitespace-nowrap shadow-2xl">
              <span class="w-2.5 h-2.5 rounded-none bg-emerald-400 animate-pulse shrink-0"></span>
              <span class="font-pixel text-xs sm:text-[13px] font-bold text-white group-hover:text-emerald-300 transition-colors tracking-wide" data-i18n="adventure_badge">{t.adventure_badge}</span>
            </button>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
