            </a>
          </div>
        </div>

        <h4 data-i18n="p3_title" class="text-xl sm:text-2xl font-bold text-white mb-4">{t.p3_title}</h4>

        <p data-i18n="p3_desc" class="text-slate-300 text-sm sm:text-base leading-relaxed mb-5">{t.p3_desc}</p>

        <div class="grid grid-cols-2 sm:flex sm:flex-wrap sm:items-center gap-1.5 sm:gap-2 pt-3 border-t border-slate-800/80 font-mono text-[11px] sm:text-xs">
          <span class="px-2 py-1 sm:px-2.5 sm:py-1 pixel-corners-btn bg-slate-800/80 text-slate-200 border border-slate-700/60 shadow-[1px_1px_0px_0px_rgba(15,23,42,0.6)] flex items-center justify-center sm:inline sm:text-left text-center leading-tight sm:whitespace-nowrap">C / C++17</span>
          <span class="px-2 py-1 sm:px-2.5 sm:py-1 pixel-corners-btn bg-slate-800/80 text-slate-200 border border-slate-700/60 shadow-[1px_1px_0px_0px_rgba(15,23,42,0.6)] flex items-center justify-center sm:inline sm:text-left text-center leading-tight sm:whitespace-nowrap">POSIX Threads / OpenMP</span>
          <span class="px-2 py-1 sm:px-2.5 sm:py-1 pixel-corners-btn bg-slate-800/80 text-slate-200 border border-slate-700/60 shadow-[1px_1px_0px_0px_rgba(15,23,42,0.6)] flex items-center justify-center sm:inline sm:text-left text-center leading-tight sm:whitespace-nowrap">Sockets TCP/IP</span>
          <span class="px-2 py-1 sm:px-2.5 sm:py-1 pixel-corners-btn bg-slate-800/80 text-slate-200 border border-slate-700/60 shadow-[1px_1px_0px_0px_rgba(15,23,42,0.6)] flex items-center justify-center sm:inline sm:text-left text-center leading-tight sm:whitespace-nowrap">JavaScript</span>
          <span class="px-2 py-1 sm:px-2.5 sm:py-1 pixel-corners-btn bg-slate-800/80 text-slate-200 border border-slate-700/60 shadow-[1px_1px_0px_0px_rgba(15,23,42,0.6)] flex items-center justify-center sm:inline sm:text-left text-center leading-tight sm:whitespace-nowrap">Firebase</span>
          <span class="px-2 py-1 sm:px-2.5 sm:py-1 pixel-corners-btn bg-slate-800/80 text-slate-200 border border-slate-700/60 shadow-[1px_1px_0px_0px_rgba(15,23,42,0.6)] flex items-center justify-center sm:inline sm:text-left text-center leading-tight sm:whitespace-nowrap">GitHub Actions</span>
        </div>

          </div>
        </div>
      </article>

