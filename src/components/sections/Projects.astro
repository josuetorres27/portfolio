---
import { useTranslations } from '../../i18n/index.js';

const t = useTranslations(Astro.currentLocale);
---
<!-- ================= FEATURED PROJECTS ================= -->
<section id="projects" class="py-12 md:py-16 border-t border-slate-800/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="mb-10">
      <div class="flex items-center gap-3 mb-2">
        <span class="h-px w-8 bg-brand-500"></span>
        <h2 data-i18n="projects_section_tag" class="text-xs uppercase tracking-widest font-bold text-brand-400 font-mono">{t.projects_section_tag}</h2>
      </div>
      <h3 data-i18n="projects_heading" class="text-2xl sm:text-3xl font-extrabold text-white">{t.projects_heading}</h3>
    </div>

    <!-- Project Cards Grid -->
    <div class="space-y-8">

      <!-- Project 1: CS Interactive Workshop -->
      <article class="card-hover pixel-frame-outer pixel-corners-card">
        <div class="pixel-frame-inner pixel-corners-card">
          <div class="terminal-header">
            <div class="flex items-center min-w-0">
              <span class="text-emerald-400 font-mono text-xs font-bold mr-1.5 select-none">&gt;</span>
              <span class="font-mono text-slate-400 text-[11px] truncate">~/projects/cs_interactive_workshop.c</span>
            </div>
            <span class="font-pixel text-[8px] text-emerald-400 shrink-0 ml-2">[C / C++ · WEB]</span>
          </div>
          <div class="p-6 sm:p-8">

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-4">
          <div class="flex flex-wrap items-center gap-2">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 pixel-corners-btn bg-slate-900 border border-emerald-500/40 text-emerald-400 text-xs font-semibold font-mono">
              <span class="w-2 h-2 rounded-none bg-emerald-400 animate-pulse shrink-0"></span>
              <span data-i18n="p3_type">{t.p3_type}</span>
            </div>
            <span data-i18n="p3_date" class="text-xs font-mono text-slate-400">{t.p3_date}</span>
          </div>
          <div class="flex flex-wrap items-center gap-3 sm:gap-2 shrink-0">
            <a href="https://workshop.josuetorressibaja.com/" target="_blank" rel="noopener noreferrer" class="pixel-btn pixel-btn-primary pixel-corners-btn px-4 py-1.5 text-xs font-semibold uppercase tracking-wider shrink-0 inline-flex items-center justify-center gap-1.5">
              <span data-i18n="p3_btn">{t.p3_btn}</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
            <a href="https://github.com/josuetorres27/cs-interactive-workshop" target="_blank" rel="noopener noreferrer" class="pixel-btn pixel-btn-secondary pixel-corners-btn px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider shrink-0 inline-flex items-center justify-center gap-2" aria-label={t.aria_gh_workshop} data-i18n-aria="aria_gh_workshop">
              <svg class="w-4 h-4 fill-current text-slate-300" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path></svg>
