---
import { useTranslations } from '../../i18n/index.js';

const t = useTranslations(Astro.currentLocale);
---
<!-- ================= MINDSET & ATTITUDE ================= -->
<section id="mindset" class="py-12 md:py-16 border-t border-slate-800/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="w-full mb-10">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="h-px w-8 bg-brand-500"></span>
        <h2 data-i18n="mindset_section_tag" class="text-xs uppercase tracking-widest font-bold text-brand-400 font-mono">{t.mindset_section_tag}</h2>
      </div>
      <h3 data-i18n="mindset_heading" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4 text-balance">{t.mindset_heading}</h3>
      <p data-i18n="mindset_intro" class="text-slate-300 text-base leading-relaxed">{t.mindset_intro}</p>
    </div>

    <!-- 4 Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- Pillar 1: Ownership -->
      <div class="card-hover pixel-frame-outer pixel-corners-card">
        <div class="pixel-frame-inner pixel-corners-card">
          <div class="terminal-header">
            <div class="flex items-center min-w-0">
              <span class="text-brand-400 font-mono text-xs font-bold mr-1.5 select-none">&gt;</span>
              <span class="font-mono text-slate-400 text-[11px] truncate">~/mindset/ownership.log</span>
            </div>
            <span class="font-pixel text-[8px] text-brand-400 shrink-0 ml-2">[PASSIVE]</span>
          </div>
          <div class="p-6 sm:p-7">

            <div class="flex items-center gap-3.5 mb-4">
              <div class="w-10 h-10 shrink-0 flex items-center justify-center select-none">
                <img src="/img/icons/shield.png" alt="Ownership & Responsibility" class="w-full h-full object-cover pixelated select-none" />
              </div>
              <div>
                <h4 data-i18n="mindset_p1_title" class="text-base font-bold text-white">{t.mindset_p1_title}</h4>
                <p data-i18n="mindset_p1_sub" class="text-xs text-brand-300 font-mono">{t.mindset_p1_sub}</p>
              </div>
            </div>
            <p data-i18n="mindset_p1_desc" class="text-slate-300 text-sm leading-relaxed">{t.mindset_p1_desc}</p>
          </div>
        </div>
      </div>

      <!-- Pillar 2: Intellectual Humility -->
      <div class="card-hover pixel-frame-outer pixel-corners-card">
        <div class="pixel-frame-inner pixel-corners-card">
          <div class="terminal-header">
            <div class="flex items-center min-w-0">
              <span class="text-cyan-400 font-mono text-xs font-bold mr-1.5 select-none">&gt;</span>
              <span class="font-mono text-slate-400 text-[11px] truncate">~/mindset/continuous_learning.log</span>
            </div>
            <span class="font-pixel text-[8px] text-cyan-400 shrink-0 ml-2">[PASSIVE]</span>
          </div>
          <div class="p-6 sm:p-7">

            <div class="flex items-center gap-3.5 mb-4">
              <div class="w-10 h-10 shrink-0 flex items-center justify-center select-none">
                <img src="/img/icons/book.png" alt="Willingness to Learn" class="w-full h-full object-cover pixelated select-none" />
              </div>
              <div>
                <h4 data-i18n="mindset_p2_title" class="text-base font-bold text-white">{t.mindset_p2_title}</h4>
                <p data-i18n="mindset_p2_sub" class="text-xs text-cyan-300 font-mono">{t.mindset_p2_sub}</p>
              </div>
            </div>
            <p data-i18n="mindset_p2_desc" class="text-slate-300 text-sm leading-relaxed">{t.mindset_p2_desc}</p>
          </div>
        </div>
      </div>

      <!-- Pillar 3: Resilience -->
      <div class="card-hover pixel-frame-outer pixel-corners-card">
        <div class="pixel-frame-inner pixel-corners-card">
          <div class="terminal-header">
            <div class="flex items-center min-w-0">
              <span class="text-emerald-400 font-mono text-xs font-bold mr-1.5 select-none">&gt;</span>
              <span class="font-mono text-slate-400 text-[11px] truncate">~/mindset/persistence.log</span>
            </div>
            <span class="font-pixel text-[8px] text-emerald-400 shrink-0 ml-2">[PASSIVE]</span>
          </div>
          <div class="p-6 sm:p-7">

            <div class="flex items-center gap-3.5 mb-4">
              <div class="w-10 h-10 shrink-0 flex items-center justify-center select-none">
                <img src="/img/icons/persistence.png" alt="Patience & Persistence" class="w-full h-full object-cover pixelated select-none" />
              </div>
              <div>
                <h4 data-i18n="mindset_p3_title" class="text-base font-bold text-white">{t.mindset_p3_title}</h4>
                <p data-i18n="mindset_p3_sub" class="text-xs text-emerald-300 font-mono">{t.mindset_p3_sub}</p>
              </div>
            </div>
            <p data-i18n="mindset_p3_desc" class="text-slate-300 text-sm leading-relaxed">{t.mindset_p3_desc}</p>
          </div>
        </div>
      </div>

      <!-- Pillar 4: Proactive Communication -->
      <div class="card-hover pixel-frame-outer pixel-corners-card">
        <div class="pixel-frame-inner pixel-corners-card">
          <div class="terminal-header">
            <div class="flex items-center min-w-0">
              <span class="text-amber-400 font-mono text-xs font-bold mr-1.5 select-none">&gt;</span>
              <span class="font-mono text-slate-400 text-[11px] truncate">~/mindset/communication.log</span>
            </div>
            <span class="font-pixel text-[8px] text-amber-400 shrink-0 ml-2">[PASSIVE]</span>
          </div>
          <div class="p-6 sm:p-7">

            <div class="flex items-center gap-3.5 mb-4">
              <div class="w-10 h-10 shrink-0 flex items-center justify-center select-none">
                <img src="/img/icons/chat-amber.png" alt="Communication & Teamwork" class="w-full h-full object-cover pixelated select-none" />
              </div>
              <div>
                <h4 data-i18n="mindset_p4_title" class="text-base font-bold text-white">{t.mindset_p4_title}</h4>
                <p data-i18n="mindset_p4_sub" class="text-xs text-amber-300 font-mono">{t.mindset_p4_sub}</p>
              </div>
            </div>
            <p data-i18n="mindset_p4_desc" class="text-slate-300 text-sm leading-relaxed">{t.mindset_p4_desc}</p>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
