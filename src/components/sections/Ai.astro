---
import { useTranslations } from '../../i18n/index.js';

const t = useTranslations(Astro.currentLocale);
---
<!-- ================= AI & LLM EXPERIENCE ================= -->
<section id="ai" class="py-12 md:py-16 border-t border-slate-800/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="w-full mb-10">
      <div class="inline-flex items-center gap-2 mb-3">
        <span class="h-px w-8 bg-cyan-500"></span>
        <h2 data-i18n="ai_section_tag" class="text-xs uppercase tracking-widest font-bold text-cyan-400 font-mono">{t.ai_section_tag}</h2>
      </div>
      <h3 data-i18n="ai_heading" class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4 text-balance">{t.ai_heading}</h3>

      <p data-i18n-html="ai_intro" class="text-slate-300 text-base leading-relaxed"><Fragment set:html={t.ai_intro} /></p>
    </div>

    <!-- 4 Core Pillars Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      
      <!-- Card 1 -->
      <div class="card-hover pixel-frame-outer pixel-corners-card flex flex-col">
        <div class="pixel-frame-inner pixel-corners-card flex flex-col h-full">
          <div class="terminal-header">
            <div class="flex items-center min-w-0">
              <span class="text-cyan-400 font-mono text-xs font-bold mr-1.5 select-none">&gt;</span>
              <span class="font-mono text-slate-400 text-[11px] truncate">~/ai/multi_agent.ts</span>
            </div>
            <span class="font-pixel text-[8px] text-cyan-400 shrink-0 ml-1.5">[AGENTS]</span>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <div class="flex items-center gap-3.5 mb-3.5">
              <div class="w-10 h-10 shrink-0 flex items-center justify-center select-none">
                <img src="/img/icons/multi-agent.png" alt="Multi-Agent Systems" class="w-full h-full object-cover pixelated select-none" />
              </div>
              <h4 data-i18n="ai_card1_title" class="text-sm sm:text-base font-bold text-white leading-snug">{t.ai_card1_title}</h4>
            </div>
            <p data-i18n="ai_card1_desc" class="text-xs text-slate-400 leading-relaxed flex-1">{t.ai_card1_desc}</p>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="card-hover pixel-frame-outer pixel-corners-card flex flex-col">
        <div class="pixel-frame-inner pixel-corners-card flex flex-col h-full">
          <div class="terminal-header">
            <div class="flex items-center min-w-0">
              <span class="text-cyan-400 font-mono text-xs font-bold mr-1.5 select-none">&gt;</span>
              <span class="font-mono text-slate-400 text-[11px] truncate">~/ai/tool_calling.json</span>
            </div>
            <span class="font-pixel text-[8px] text-cyan-400 shrink-0 ml-1.5">[TOOLS]</span>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <div class="flex items-center gap-3.5 mb-3.5">
              <div class="w-10 h-10 shrink-0 flex items-center justify-center select-none">
                <img src="/img/icons/tool-calling.png" alt="Function & Tool Calling" class="w-full h-full object-cover pixelated select-none" />
              </div>
              <h4 data-i18n="ai_card2_title" class="text-sm sm:text-base font-bold text-white leading-snug">{t.ai_card2_title}</h4>
            </div>
            <p data-i18n="ai_card2_desc" class="text-xs text-slate-400 leading-relaxed flex-1">{t.ai_card2_desc}</p>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="card-hover pixel-frame-outer pixel-corners-card flex flex-col">
        <div class="pixel-frame-inner pixel-corners-card flex flex-col h-full">
          <div class="terminal-header">
            <div class="flex items-center min-w-0">
              <span class="text-cyan-400 font-mono text-xs font-bold mr-1.5 select-none">&gt;</span>
              <span class="font-mono text-slate-400 text-[11px] truncate">~/ai/prompt_engine.md</span>
            </div>
            <span class="font-pixel text-[8px] text-cyan-400 shrink-0 ml-1.5">[PROMPT]</span>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <div class="flex items-center gap-3.5 mb-3.5">
              <div class="w-10 h-10 shrink-0 flex items-center justify-center select-none">
                <img src="/img/icons/prompt-engineering.png" alt="Context & Prompting" class="w-full h-full object-cover pixelated select-none" />
              </div>
              <h4 data-i18n="ai_card3_title" class="text-sm sm:text-base font-bold text-white leading-snug">{t.ai_card3_title}</h4>
            </div>
            <p data-i18n="ai_card3_desc" class="text-xs text-slate-400 leading-relaxed flex-1">{t.ai_card3_desc}</p>
          </div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="card-hover pixel-frame-outer pixel-corners-card flex flex-col">
        <div class="pixel-frame-inner pixel-corners-card flex flex-col h-full">
          <div class="terminal-header">
            <div class="flex items-center min-w-0">
              <span class="text-cyan-400 font-mono text-xs font-bold mr-1.5 select-none">&gt;</span>
              <span class="font-mono text-slate-400 text-[11px] truncate">~/ai/models_config.yaml</span>
            </div>
            <span class="font-pixel text-[8px] text-cyan-400 shrink-0 ml-1.5">[MODELS]</span>
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <div class="flex items-center gap-3.5 mb-3.5">
              <div class="w-10 h-10 shrink-0 flex items-center justify-center select-none">
                <img src="/img/icons/ai-models.png" alt="Models & Ecosystem" class="w-full h-full object-cover pixelated select-none" />
              </div>
              <h4 data-i18n="ai_card4_title" class="text-sm sm:text-base font-bold text-white leading-snug">{t.ai_card4_title}</h4>
            </div>
            <p data-i18n="ai_card4_desc" class="text-xs text-slate-400 leading-relaxed flex-1">{t.ai_card4_desc}</p>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Action: Portfolio Repository -->
    <div class="mt-8 pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-t border-slate-800/70">
      <p data-i18n-html="ai_portfolio_note" class="text-xs text-slate-400 font-mono"><Fragment set:html={t.ai_portfolio_note} /></p>
      <a href="https://github.com/josuetorres27/portfolio" target="_blank" rel="noopener noreferrer" class="shrink-0 pixel-btn pixel-btn-secondary pixel-corners-btn px-3.5 py-2 text-xs text-cyan-400 hover:text-cyan-300 font-semibold font-mono inline-flex items-center gap-2 md:mr-8 xl:mr-0">
        <span data-i18n="ai_banner_btn">{t.ai_banner_btn}</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
      </a>
    </div>

  </div>
</section>
