---
import { useTranslations } from '../../i18n/index.js';

const t = useTranslations(Astro.currentLocale);
---
<!-- ================= ABOUT ME ================= -->
<section id="about" class="py-12 md:py-16 border-t border-slate-800/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex items-center gap-3 mb-8">
      <span class="h-px w-8 bg-brand-500"></span>
      <h2 data-i18n="about_section_tag" class="text-xs uppercase tracking-widest font-bold text-brand-400 font-mono">{t.about_section_tag}</h2>
    </div>

    <!-- Narrative Box (Profile Statement - Full Width Extended) -->
    <div class="card-hover w-full pixel-frame-outer pixel-corners-card flex flex-col">
      <div class="pixel-frame-inner pixel-corners-card flex flex-col h-full">
        <div class="terminal-header">
          <div class="flex items-center min-w-0">
            <span class="text-brand-400 font-mono text-xs font-bold mr-1.5 select-none">&gt;</span>
            <span class="font-mono text-slate-400 text-[11px] truncate">~/profile/bio_statement.md</span>
          </div>
          <span class="font-pixel text-[8px] text-brand-400 shrink-0 ml-2">[PROFILE]</span>
        </div>
        <div class="p-6 sm:p-8 md:p-10 space-y-4 sm:space-y-5 text-slate-300 leading-relaxed text-base sm:text-lg flex-1 flex flex-col justify-center">
          <p data-i18n-html="about_p1"><Fragment set:html={t.about_p1} /></p>
          <p data-i18n-html="about_p2"><Fragment set:html={t.about_p2} /></p>
          <p data-i18n-html="about_p3"><Fragment set:html={t.about_p3} /></p>
        </div>
      </div>
    </div>

  </div>
</section>
