<!-- ================= ADVENTURE MODE (PIXEL JOSUE & LEVEL RAIL) ================= -->

<!-- Flying / Leaping Sprite (Used during pop-out animation) -->
<div id="flying-pixel-sprite" class="fixed pointer-events-none z-[100] hidden">
  <img id="flying-pixel-sprite-img" src="/img/character-sprites/jump.png" class="w-16 h-16 pixelated drop-shadow-[0_12px_24px_rgba(2,132,199,0.7)]" alt="Pixel Josue" />
</div>

<!-- Side Quest Level Rail (Right Sidebar on Desktop / Tablet) -->
<aside id="adventure-rail" class="fixed right-3 sm:right-5 top-auto bottom-[186px] sm:bottom-[176px] z-40 hidden flex-col items-center opacity-0 transform translate-x-48 pointer-events-none" aria-label="Navegación de nivel de Modo Aventura">
  
  <!-- Outer Wrapper (NO clip-path: allows walker and indicator to render outside) -->
  <div id="adventure-rail-wrapper" class="relative flex flex-col items-center">

    <!-- Animated Walking Sprite on the Rail (Enlarged Pixel Art - Outside clip-path!) -->
    <div id="rail-character-walker" class="absolute -left-[86px] sm:-left-[94px] flex items-center justify-center pointer-events-auto cursor-pointer group select-none z-30 p-2" style="top: 0px;" title="¡Hazme clic para saltar!">
      <div id="rail-character-scale-wrap" class="relative flex items-center justify-center">
        <img id="rail-character-sprite" src="/img/character-sprites/idle.png" class="w-16 h-16 sm:w-20 sm:h-20 pixelated drop-shadow-[0_4px_16px_rgba(2,132,199,0.65)]" alt="Pixel Josue" />
      </div>
    </div>

    <!-- Active Node Cyan Indicator (Positioned right on the container line, between walker and level node!) -->
    <div id="rail-active-indicator" class="absolute -left-[13px] sm:-left-[16px] pointer-events-none z-40 flex items-center justify-center" style="top: 0px;">
      <span class="w-2.5 h-2.5 rounded-none bg-cyan-400 border-0 animate-pulse shadow-[0_0_8px_rgba(6,182,212,0.9)]"></span>
    </div>

    <!-- Map Track Card (Has pixel-corners-card) -->
    <div id="adventure-rail-card" class="relative py-2 px-1.5 sm:px-2 pixel-corners-card bg-slate-950/95 border border-slate-800/90 shadow-2xl flex flex-col items-center">
      
      <!-- Top Rail Header / Controls -->
      <div class="flex flex-col items-center py-0.5 pb-1 mb-1 border-b border-slate-800/80 w-full text-center">
        <span data-i18n="adv_map_title" class="text-[9px] font-mono font-bold tracking-widest text-brand-400">MAPA</span>
        
      </div>

      <!-- Vertical Level Track Line -->
      <div id="rail-track-container" class="relative flex flex-col items-center gap-1 sm:gap-1.5">
        <div class="absolute top-2 bottom-2 left-1/2 -translate-x-1/2 w-0.5 bg-gradient-to-b from-brand-500 via-cyan-500 to-indigo-500 opacity-30"></div>

        <!-- Level Checkpoint Buttons -->
      <button type="button" data-level="0" data-target="#hero" class="rail-node group relative z-10 w-8 h-8 sm:w-9 sm:h-9 pixel-corners-sm flex items-center justify-center text-xs sm:text-sm font-mono font-bold transition-all bg-slate-900 border border-slate-700/80 text-slate-400 hover:text-white hover:border-brand-500 active:scale-95" aria-label="Nivel 1: Inicio">
        <img src="/img/icons/map-flag.png" alt="Inicio" class="w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <span class="rail-tooltip hidden group-hover:block absolute right-full mr-2.5 px-2.5 py-1 text-[11px] font-mono font-medium text-slate-200 whitespace-nowrap">1. Inicio</span>
      </button>
      <button type="button" data-level="1" data-target="#about" class="rail-node group relative z-10 w-8 h-8 sm:w-9 sm:h-9 pixel-corners-sm flex items-center justify-center text-xs sm:text-sm font-mono font-bold transition-all bg-slate-900 border border-slate-700/80 text-slate-400 hover:text-white hover:border-brand-500 active:scale-95" aria-label="Nivel 2: Sobre Mí">
        <img src="/img/icons/map-profile-dark.png" alt="Sobre Mí" class="theme-icon-dark w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <img src="/img/icons/map-profile-light.png" alt="Sobre Mí" class="theme-icon-light w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <span class="rail-tooltip hidden group-hover:block absolute right-full mr-2.5 px-2.5 py-1 text-[11px] font-mono font-medium text-slate-200 whitespace-nowrap">2. Sobre Mí</span>
      </button>
      <button type="button" data-level="2" data-target="#experience" class="rail-node group relative z-10 w-8 h-8 sm:w-9 sm:h-9 pixel-corners-sm flex items-center justify-center text-xs sm:text-sm font-mono font-bold transition-all bg-slate-900 border border-slate-700/80 text-slate-400 hover:text-white hover:border-brand-500 active:scale-95" aria-label="Nivel 3: Experiencia">
        <img src="/img/icons/map-briefcase.png" alt="Experiencia" class="w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <span class="rail-tooltip hidden group-hover:block absolute right-full mr-2.5 px-2.5 py-1 text-[11px] font-mono font-medium text-slate-200 whitespace-nowrap">3. Experiencia</span>
      </button>
      <button type="button" data-level="3" data-target="#education" class="rail-node group relative z-10 w-8 h-8 sm:w-9 sm:h-9 pixel-corners-sm flex items-center justify-center text-xs sm:text-sm font-mono font-bold transition-all bg-slate-900 border border-slate-700/80 text-slate-400 hover:text-white hover:border-brand-500 active:scale-95" aria-label="Nivel 4: Educación">
        <img src="/img/icons/map-education.png" alt="EducaciÃ³n" class="w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <span class="rail-tooltip hidden group-hover:block absolute right-full mr-2.5 px-2.5 py-1 text-[11px] font-mono font-medium text-slate-200 whitespace-nowrap">4. Educación</span>
      </button>
      <button type="button" data-level="4" data-target="#skills" class="rail-node group relative z-10 w-8 h-8 sm:w-9 sm:h-9 pixel-corners-sm flex items-center justify-center text-xs sm:text-sm font-mono font-bold transition-all bg-slate-900 border border-slate-700/80 text-slate-400 hover:text-white hover:border-brand-500 active:scale-95" aria-label="Nivel 5: Habilidades">
        <img src="/img/icons/map-skills.png" alt="Habilidades" class="w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <span class="rail-tooltip hidden group-hover:block absolute right-full mr-2.5 px-2.5 py-1 text-[11px] font-mono font-medium text-slate-200 whitespace-nowrap">5. Habilidades</span>
      </button>
      <button type="button" data-level="5" data-target="#projects" class="rail-node group relative z-10 w-8 h-8 sm:w-9 sm:h-9 pixel-corners-sm flex items-center justify-center text-xs sm:text-sm font-mono font-bold transition-all bg-slate-900 border border-slate-700/80 text-slate-400 hover:text-white hover:border-brand-500 active:scale-95" aria-label="Nivel 6: Proyectos">
        <img src="/img/icons/map-rocket-dark.png" alt="Proyectos" class="theme-icon-dark w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <img src="/img/icons/map-rocket-light.png" alt="Proyectos" class="theme-icon-light w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <span class="rail-tooltip hidden group-hover:block absolute right-full mr-2.5 px-2.5 py-1 text-[11px] font-mono font-medium text-slate-200 whitespace-nowrap">6. Proyectos</span>
      </button>
      <button type="button" data-level="6" data-target="#ai" class="rail-node group relative z-10 w-8 h-8 sm:w-9 sm:h-9 pixel-corners-sm flex items-center justify-center text-xs sm:text-sm font-mono font-bold transition-all bg-slate-900 border border-slate-700/80 text-slate-400 hover:text-white hover:border-brand-500 active:scale-95" aria-label="Nivel 7: IA & LLMs">
        <img src="/img/icons/map-robot.png" alt="IA & LLMs" class="w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <span class="rail-tooltip hidden group-hover:block absolute right-full mr-2.5 px-2.5 py-1 text-[11px] font-mono font-medium text-slate-200 whitespace-nowrap">7. IA & LLMs</span>
      </button>
      <button type="button" data-level="7" data-target="#interests" class="rail-node group relative z-10 w-8 h-8 sm:w-9 sm:h-9 pixel-corners-sm flex items-center justify-center text-xs sm:text-sm font-mono font-bold transition-all bg-slate-900 border border-slate-700/80 text-slate-400 hover:text-white hover:border-brand-500 active:scale-95" aria-label="Nivel 8: Pasiones">
        <img src="/img/icons/map-gamepad-dark.png" alt="Pasiones" class="theme-icon-dark w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <img src="/img/icons/map-gamepad-light.png" alt="Pasiones" class="theme-icon-light w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <span class="rail-tooltip hidden group-hover:block absolute right-full mr-2.5 px-2.5 py-1 text-[11px] font-mono font-medium text-slate-200 whitespace-nowrap">8. Pasiones</span>
      </button>
      <button type="button" data-level="8" data-target="#contact" class="rail-node group relative z-10 w-8 h-8 sm:w-9 sm:h-9 pixel-corners-sm flex items-center justify-center text-xs sm:text-sm font-mono font-bold transition-all bg-slate-900 border border-slate-700/80 text-slate-400 hover:text-white hover:border-brand-500 active:scale-95" aria-label="Nivel 9: Contacto">
        <img src="/img/icons/map-mail-dark.png" alt="Contacto" class="theme-icon-dark w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <img src="/img/icons/map-mail-light.png" alt="Contacto" class="theme-icon-light w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none" />
        <span class="rail-tooltip hidden group-hover:block absolute right-full mr-2.5 px-2.5 py-1 text-[11px] font-mono font-medium text-slate-200 whitespace-nowrap">9. Contacto</span>
      </button>
    </div>

      <!-- Exit Button -->
      <div class="pt-1 mt-1 border-t border-slate-800/80 w-full flex justify-center">
        <button id="rail-exit-btn" type="button" class="group relative z-10 w-8 h-8 sm:w-9 sm:h-9 pixel-corners-sm flex items-center justify-center transition-all active:scale-95 cursor-pointer" aria-label="Close Adventure Mode" data-i18n-aria="adv_close_mode" title="Cerrar Modo Aventura">
          <img src="/img/icons/close-x-dark.png" alt="Cerrar" class="theme-icon-dark w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none transition-transform group-hover:scale-110" />
          <img src="/img/icons/close-x-light.png" alt="Cerrar" class="theme-icon-light w-4 h-4 sm:w-5 sm:h-5 pixelated select-none pointer-events-none transition-transform group-hover:scale-110" />
          <span id="rail-exit-tooltip" class="rail-tooltip hidden group-hover:block absolute right-full mr-2.5 px-2.5 py-1 text-[11px] font-mono font-medium text-slate-200 whitespace-nowrap">Salir</span>
        </button>
      </div>
    </div><!-- /#adventure-rail-card -->
  </div><!-- /#adventure-rail-wrapper -->
</aside>

<!-- Companion Dialogue Box (Bottom Floating - Stepped Pixel Art Frame) -->
<div id="adventure-dialogue-box" class="fixed bottom-4 left-3 right-3 sm:left-auto sm:right-5 sm:bottom-5 z-50 w-auto sm:w-[480px] h-[174px] sm:h-[146px] pixel-corners-card p-[2px] hidden opacity-0 transform translate-x-full select-none pointer-events-none transition-all">
  <div id="adventure-dialogue-inner" class="pixel-corners-card w-full h-full p-3.5 sm:p-4 bg-slate-950/95 flex items-center gap-3.5">
    <!-- Avatar with Live Animations (Enlarged & Stepped Pixel Frame - No green dot) -->
    <button id="dialogue-avatar-btn" type="button" class="w-16 h-16 sm:w-20 sm:h-20 pixel-corners-sm bg-slate-900 border border-brand-500/40 flex items-center justify-center shrink-0 p-1 group hover:border-brand-400 transition-all active:scale-95 relative cursor-pointer shadow-lg shadow-brand-500/10" title="¡Hazme clic para saltar!">
      <img id="dialogue-avatar-sprite" src="/img/character-sprites/idle.png" class="w-14 h-14 sm:w-16 sm:h-16 pixelated transition-transform duration-200" alt="Pixel Josue" />
    </button>

    <!-- Dialogue Content (w-full ensures right-aligned buttons stay pinned to edge from start) -->
    <div class="flex-1 min-w-0 flex flex-col justify-between h-full w-full">
      <div class="flex items-center justify-between gap-2 mb-1 w-full">
        <div class="flex items-center gap-1.5">
          <span data-i18n="adv_companion_name" class="text-xs font-mono font-bold text-white tracking-tight">Pixel Josue</span>
          <span data-i18n="adv_badge_guide" class="text-[10px] px-2 py-0.5 pixel-corners-btn border-cyan-800/60 text-cyan-300 font-mono font-medium">Guía</span>
        </div>
        <div class="flex items-center gap-1 text-slate-400">
          <button id="dialogue-mute-btn" type="button" class="w-6 h-6 sm:w-7 sm:h-7 hover:text-white text-xs transition-colors flex items-center justify-center cursor-pointer pointer-events-auto border-0 shadow-none bg-transparent" title="Activar/Silenciar sonido">
            <img id="dialogue-mute-img" src="/img/icons/sound-on-dark.png" alt="Sonido activado" class="w-3.5 h-3.5 pixelated select-none pointer-events-none" />
          </button>
          <button id="dialogue-close-btn" type="button" class="w-6 h-6 sm:w-7 sm:h-7 hover:text-white text-xs transition-colors flex items-center justify-center cursor-pointer pointer-events-auto border-0 shadow-none bg-transparent" title="Cerrar Guía">
            <img src="/img/icons/close-x-dark.png" alt="Cerrar" class="theme-icon-dark w-3.5 h-3.5 pixelated select-none pointer-events-none" />
            <img src="/img/icons/close-x-light.png" alt="Cerrar" class="theme-icon-light w-3.5 h-3.5 pixelated select-none pointer-events-none" />
          </button>
        </div>
      </div>

      <p id="dialogue-text" class="text-xs sm:text-[13px] text-slate-200 leading-snug font-sans h-[84px] sm:h-[58px] overflow-hidden w-full"></p>

      <div class="pt-1.5 border-t border-slate-800/80 flex items-center justify-between text-[10px] font-mono text-slate-400 w-full">
        <span id="dialogue-stage-label" class="text-brand-400 font-semibold whitespace-nowrap">NIVEL 1/9 · INICIO</span>
        <span data-i18n="adv_scroll_hint" class="hidden sm:inline text-slate-500 italic whitespace-nowrap">Haz scroll o clic en el mapa</span>
      </div>
    </div>
  </div>
</div>

<!-- Pre-rendered DOM Sprite Cache for instant zero-latency swap -->
<div id="character-sprites-cache" class="hidden" aria-hidden="true">
  <img src="/img/character-sprites/idle.png" alt="" loading="eager" />
  <img src="/img/character-sprites/front.png" alt="" loading="eager" />
  <img src="/img/character-sprites/jump.png" alt="" loading="eager" />
  <img src="/img/character-sprites/walk-1.png" alt="" loading="eager" />
  <img src="/img/character-sprites/walk-2.png" alt="" loading="eager" />
  <img src="/img/character-sprites/back.png" alt="" loading="eager" />
  <img src="/img/character-sprites/back-walk-1.png" alt="" loading="eager" />
  <img src="/img/character-sprites/back-walk-2.png" alt="" loading="eager" />
</div>
