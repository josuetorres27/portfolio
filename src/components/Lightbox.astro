---
import { useTranslations } from '../i18n/index.js';

const t = useTranslations(Astro.currentLocale);
---
<!-- ================= IMAGE LIGHTBOX MODAL ================= -->
<div id="image-lightbox-modal" class="hidden fixed inset-0 z-[150] flex items-center justify-center p-3 sm:p-6 overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="lightbox-caption">
  <div class="relative max-w-4xl w-full flex flex-col items-center my-auto">
    
    <!-- Top Bar: Caption & Location above image + Close Button -->
    <div id="lightbox-header-bar" class="w-full flex flex-col gap-2 mb-2.5 sm:mb-3 px-1 sm:px-2">
      <!-- Row 1: Caption on the left, Close button on the right -->
      <div class="w-full flex items-center justify-between gap-3">
        <p id="lightbox-caption" class="text-sm sm:text-base font-semibold tracking-wide truncate text-white min-w-0 flex-1"></p>
        
        <button id="lightbox-close-btn" type="button" aria-label={t.aria_close_image} data-i18n-aria="aria_close_image" class="flex-shrink-0 pixel-btn pixel-btn-icon pixel-corners-btn p-2" title="Cerrar">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>
      
      <!-- Row 2: Location Link / Google Maps Badge (shown when image has location data) -->
      <div id="lightbox-location-container" class="hidden w-full flex items-center">
        <a id="lightbox-location-link" href="#" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto inline-flex items-center justify-between sm:justify-start px-3 sm:px-3.5 py-1.5 pixel-corners-btn text-xs font-medium transition-all active:scale-95 shadow-sm group/loc" title="Abrir ubicación en Google Maps">
          <div class="w-1/2 sm:w-auto flex items-center justify-center sm:justify-start gap-1.5 min-w-0 pr-2 sm:pr-3">
            <svg class="w-3.5 h-3.5 text-cyan-400 group-hover/loc:scale-110 transition-transform fill-current flex-shrink-0" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span id="lightbox-location-text" class="font-sans font-medium text-[11px] sm:text-xs truncate max-w-full sm:max-w-md"></span>
          </div>
          <span class="w-1/2 sm:w-auto inline-flex items-center justify-center sm:justify-start gap-1 text-[10px] sm:text-[11px] font-mono opacity-90 pl-2 sm:pl-3 border-l border-cyan-500/30 flex-shrink-0 whitespace-nowrap">
            <span data-i18n="lightbox_view_maps">{t.lightbox_view_maps}</span>
            <svg class="w-3 h-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </span>
        </a>
      </div>
    </div>

    <!-- Image Display Container (Pixel Art Stepped Corners) -->
    <div id="lightbox-content-box" class="relative pixel-corners-photo overflow-hidden flex items-center justify-center max-w-full">
      <img id="lightbox-img" src="" alt="" class="w-auto h-auto max-w-full object-contain pixel-corners-photo">
    </div>
  </div>
</div>
