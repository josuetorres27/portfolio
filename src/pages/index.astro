---
import BaseLayout from '../layouts/BaseLayout.astro';
import Preloader from '../components/Preloader.astro';
import PixelSprites from '../components/PixelSprites.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Experience from '../components/sections/Experience.astro';
import Education from '../components/sections/Education.astro';
import Skills from '../components/sections/Skills.astro';
import Projects from '../components/sections/Projects.astro';
import Ai from '../components/sections/Ai.astro';
import Mindset from '../components/sections/Mindset.astro';
import Interests from '../components/sections/Interests.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import AdventureMode from '../components/AdventureMode.astro';
---
<BaseLayout>
  <Preloader />

  <PixelSprites />

  <!-- Glow Background Effect -->
  <div class="absolute top-0 left-0 right-0 h-[600px] radial-bg pointer-events-none -z-10"></div>

  <!-- Main Page Content Stage Wrapper (Shifts during Adventure Mode) -->
  <div id="adventure-stage-wrapper">
    <Navbar />
    <Hero />
    <About />
    <Experience />
    <Education />
    <Skills />
    <Projects />
    <Ai />
    <Mindset />
    <Interests />
    <Contact />
    <Footer />
  </div><!-- /adventure-stage-wrapper -->

  <Lightbox />

  <AdventureMode />
</BaseLayout>
